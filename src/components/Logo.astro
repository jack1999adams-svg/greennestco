---
// GNc emblem: "Greennestco" wordmark beside a thin circle-and-leaf mark
// (foundation, Part 8). The wordmark is live text (Playfair) so it stays crisp;
// the mark is SVG and inherits `currentColor`. Drops straight into a flex parent.
interface Props {
  withWord?: boolean;
}
const { withWord = true } = Astro.props;
---
<svg class="logo-mark" viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.3" />
  <path
    d="M33 15c-11 1-19 8-20 18 0 4 1 6 1 6s3 0 6-2c8-5 12-14 13-22Z"
    fill="currentColor"
  />
  <path d="M27 21c-5 4-9 9-11 16" stroke="#fcfaf5" stroke-width="1.4" stroke-linecap="round" opacity="0.7" />
</svg>
{withWord && <span class="logo-word">Green<b>nest</b>co</span>}
