---
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import { categories } from '../../data/categories.mjs';
---

<Base
  title="Shop by Category — Green Nest Co"
  description="Shop by category: furniture, pottery & ceramics, textiles, baskets, aromatherapy & candles, art & wall decor, plants, and outdoor living."
>
  <section class="page-hero">
    <div class="container">
      <hr class="eyebrow-rule" />
      <span class="kicker">Shop by Category</span>
      <h1>The GNc product universe</h1>
      <p class="lede">Fewer, better things — grouped by the material worlds they belong to.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="grid-3">
        {categories.map((c) => (
          <a class="tile" href={`/categories/${c.slug}/`}>
            <Placeholder label={c.name} tone={['pottery-ceramics','plants','furniture','outdoor-living'].includes(c.slug) ? 'sage' : 'sand'} shape="wide" />
            <div class="tile-body">
              <span class="chip clay">{c.tone}</span>
              <h3 style="margin-top:12px">{c.name}</h3>
              <p>{c.blurb}</p>
              <span class="tile-more">Explore →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
